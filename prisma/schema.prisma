// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =======================================
//        Modelos de Autenticación y Usuarios
// =======================================

model Role {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  markup Decimal @default(0) @db.Decimal(10, 4)
  users  User[]

  installationPriceProfileId Int?
  installationPriceProfile   InstallationPriceProfile? @relation("RoleInstallationPriceProfile", fields: [installationPriceProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installationPriceProfileId])
}

enum DealerMode {
  EXTERNAL
  INTERNAL
}

enum DealerAffiliation {
  IMPACT
  AUTHENTIC
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  phone             String   @unique
  password          String
  passwordUpdatedAt DateTime @default(now())

  street     String @db.VarChar(150)
  city       String @db.VarChar(100)
  state      String @db.VarChar(50)
  postalCode String @db.VarChar(20)

  markupOverride Decimal? @db.Decimal(24, 18)
  isTaxExempt    Boolean  @default(false)

  // Only dealer accounts use these two independent classifications.
  dealerMode        DealerMode?
  dealerAffiliation DealerAffiliation?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  role   Role @relation(fields: [idRole], references: [id])
  idRole Int

  installationPriceProfileId Int?
  installationPriceProfile   InstallationPriceProfile? @relation("UserInstallationPriceProfile", fields: [installationPriceProfileId], references: [id], onDelete: SetNull)

  estimates                         Estimate[]
  payments                          Payment[]
  orders                            Order[]
  notifications                     Notification[]
  sessions                          Session[]
  passwordResetTokens               PasswordResetToken[]
  branding                          Branding?
  eventLogs                         EventLog[]
  installationRequests              InstallationJob[]           @relation("InstallationRequestedBy")
  installationMeasurements          InstallationMeasurement[]   @relation("InstallationMeasuredBy")
  installationQuotesCreated         InstallationQuote[]         @relation("InstallationQuoteCreatedBy")
  installationQuoteApprovals        InstallationQuoteApproval[]
  estimateRevisionsCreated          EstimateRevision[]          @relation("EstimateRevisionCreatedBy")
  installationAppointmentsProposed  InstallationAppointment[]   @relation("InstallationAppointmentProposedBy")
  installationAppointmentsResponded InstallationAppointment[]   @relation("InstallationAppointmentRespondedBy")
  orderExtraChargesCreated          OrderExtraCharge[]          @relation("OrderExtraChargeCreatedBy")
  orderExtraChargesResponded        OrderExtraCharge[]          @relation("OrderExtraChargeRespondedBy")
  manualPaymentsRecorded            Payment[]                   @relation("PaymentRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([deletedAt])
  @@index([installationPriceProfileId])
  @@index([dealerMode, dealerAffiliation])
}

model Session {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  refreshTokenHash String @db.VarChar(255)

  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  lastRefreshedAt DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(64)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum BrandingType {
  COMPANY
  DEALER
}

model Branding {
  id Int @id @default(autoincrement())

  type   BrandingType
  userId Int?         @unique // solo cuando type=DEALER  1 branding por dealer

  // Header info
  name    String  @db.VarChar(150)
  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(150)
  website String? @db.VarChar(150)

  street     String? @db.VarChar(150)
  city       String? @db.VarChar(100)
  state      String? @db.VarChar(50)
  postalCode String? @db.VarChar(20)

  logoUrl String? @db.VarChar(500)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación (dealer)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reglas para que no se dupliquen:

  @@index([type, isActive])
  @@map("branding")
}

// =======================================
//        Modelos de Piezas y Opciones
// =======================================

model Brand {
  id                 Int                 @id @default(autoincrement())
  name               String
  isActive           Boolean             @default(true)
  highBottomPercent  Decimal?            @db.Decimal(10, 4)
  pieces             Piece[]
  brandProducts      BrandProduct[]
  brandTints         BrandTint[]
  brandCoatings      BrandCoating[]
  brandPrivacies     BrandPrivacy[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([isActive])
}

model Product {
  id        Int     @id @default(autoincrement())
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  kind        ProductKind @default(GLAZED_UNIT)
  pricingMode PricingMode @default(AREA_PERIMETER)

  // comentario en español: selecciona la familia visual del diagrama
  diagramFamily DiagramFamily @default(GENERIC)

  configs            Config[]
  configCategories   ConfigCategory[]
  pieces             Piece[]
  brandProducts      BrandProduct[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isActive, sortOrder])
  @@index([kind])
  @@index([diagramFamily])
}

enum ProductKind {
  GLAZED_UNIT
  LINEAR_MATERIAL
}

enum DiagramFamily {
  GENERIC
  BIFOLD
  CASEMENT
  FIXED_SHAPE
  FRENCH_DOOR
  GARAGE_DOOR
  HORIZONTAL_SLIDER
  LINEAR_MATERIAL
  PIVOT_DOOR
  SINGLE_HUNG
  SLIDING_DOOR
  WINDOW_WALL
}

model BrandProduct {
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  systems   System[]

  @@id([idBrand, idProduct])
  @@map("brand_product")
}

model System {
  id           Int          @id @default(autoincrement())
  name         String
  brandProduct BrandProduct @relation(fields: [idBrand, idProduct], references: [idBrand, idProduct])
  idBrand      Int
  idProduct    Int

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  allowHighBottom Boolean @default(false)

  defaultCrystalId Int?
  defaultCrystal   Crystal? @relation("SystemDefaultCrystal", fields: [defaultCrystalId], references: [id], onDelete: SetNull)

  defaultConfigId Int?
  defaultConfig   Config? @relation("SystemDefaultConfig", fields: [defaultConfigId], references: [id], onDelete: SetNull)

  systemCrystals    SystemCrystal[]
  systemFrameColors SystemFrameColor[]

  sysconfs           SysConf[]
  pieces             Piece[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([defaultCrystalId])
  @@index([defaultConfigId])
  @@index([isActive])
  @@index([idBrand, idProduct, sortOrder])
}

model Config {
  id        Int     @id @default(autoincrement())
  conf      String
  prod      Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  isActive  Boolean @default(true)

  categoryId Int?
  category   ConfigCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sysconfs           SysConf[]
  defaultForSystems  System[]            @relation("SystemDefaultConfig")
  pieces             Piece[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]

  requiresWidth        Boolean @default(false)
  requiresHeight       Boolean @default(false)
  requiresHeightLeft   Boolean @default(false)
  requiresHeightRight  Boolean @default(false)
  requiresLegHeight    Boolean @default(false)
  requiresSashHeight   Boolean @default(false)
  requiresWindowHeight Boolean @default(false)

  // Number of physical panels that this configuration always contains.
  // It is copied to Piece.panelCount so installation pricing keeps a snapshot.
  fixedPanelCount Int?

  muntinLayout Json?

  // comentario en español: estructura visual base de la configuración
  // Puede referenciar valores dinámicos de Piece como rightPanels.
  diagramSpec Json?

  // comentario en español: permite migrar la estructura JSON en el futuro
  diagramSpecVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([idProduct, isActive])
  @@index([categoryId])
}

model ConfigCategory {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  product   Product @relation(fields: [idProduct], references: [id], onDelete: Cascade)
  idProduct Int

  configs Config[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idProduct, name])
  @@index([idProduct])
  @@index([isActive])
  @@map("config_categories")
}

enum PricingComponentType {
  DOOR
  SIDELITE
}

enum BillableHeightMode {
  ACTUAL_HEIGHT
  WIDTH_PERCENTAGE
  FIXED
}

model SysConf {
  system                       System             @relation(fields: [idSystem], references: [id])
  idSystem                     Int
  config                       Config             @relation(fields: [idConfig], references: [id])
  idConfig                     Int
  allowScreen                  Boolean            @default(false)
  isSelectableInEstimate       Boolean            @default(true)
  sortOrder                    Int                @default(0)
  dimensionMode                DimensionMode      @default(STANDARD)
  minimumBillableWidthIn       Decimal?           @db.Decimal(10, 3)
  minimumBillableHeightIn      Decimal?           @db.Decimal(10, 3)
  billableHeightMode           BillableHeightMode @default(ACTUAL_HEIGHT)
  billableHeightPercentOfWidth Decimal?           @db.Decimal(10, 3)
  billableHeightFixedIn        Decimal?           @db.Decimal(10, 3)

  requiresWidth       Boolean @default(false)
  requiresHeight      Boolean @default(false)
  requiresHeightLeft  Boolean @default(false)
  requiresHeightRight Boolean @default(false)
  requiresLegHeight   Boolean @default(false)

  requiresDoorWidth          Boolean @default(false)
  requiresDoorHeight         Boolean @default(false)
  requiresLeftSideliteWidth  Boolean @default(false)
  requiresRightSideliteWidth Boolean @default(false)

  requiresLeftPanels  Boolean @default(false)
  requiresRightPanels Boolean @default(false)

  requiresPanelCount        Boolean @default(false)
  requiresHorizontalHeights Boolean @default(false)

  defaultActiveOptionId        Int?
  defaultPreparationOptionId   Int?
  defaultSillOptionId          Int?
  defaultReinforcementOptionId Int?

  defaultActiveOption        ActiveOption?        @relation("SysConfDefaultActiveOption", fields: [defaultActiveOptionId], references: [id], onDelete: SetNull)
  defaultPreparationOption   PreparationOption?   @relation("SysConfDefaultPreparationOption", fields: [defaultPreparationOptionId], references: [id], onDelete: SetNull)
  defaultSillOption          SillOption?          @relation("SysConfDefaultSillOption", fields: [defaultSillOptionId], references: [id], onDelete: SetNull)
  defaultReinforcementOption ReinforcementOption? @relation("SysConfDefaultReinforcementOption", fields: [defaultReinforcementOptionId], references: [id], onDelete: SetNull)

  dimensionPolicies    DimensionPolicy[]            @relation("SysConfDimensionPolicies")
  pricingComponents    SysConfPricingComponent[]    @relation("SysConfPricingComponentParent")
  usedAsPricingSource  SysConfPricingComponent[]    @relation("SysConfPricingComponentSource")
  pricingRanges        PricingRange[]               @relation("SysConfPricingRanges")
  installationServices SysConfInstallationService[]

  activeOptions        SysConfActiveOption[]
  preparationOptions   SysConfPreparationOption[]
  sillOptions          SysConfSillOption[]
  reinforcementOptions SysConfReinforcementOption[]

  @@id([idSystem, idConfig])
  @@index([defaultActiveOptionId])
  @@index([defaultPreparationOptionId])
  @@index([defaultSillOptionId])
  @@index([defaultReinforcementOptionId])
  @@map("sys_conf")
}

model SysConfPricingComponent {
  idSystem       Int
  idConfig       Int
  componentType  PricingComponentType
  sourceConfigId Int
  quantity       Int?

  parentSysConf SysConf @relation("SysConfPricingComponentParent", fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  sourceSysConf SysConf @relation("SysConfPricingComponentSource", fields: [idSystem, sourceConfigId], references: [idSystem, idConfig], onDelete: Restrict)

  @@id([idSystem, idConfig, componentType])
  @@index([idSystem, sourceConfigId], map: "idx_sys_conf_pricing_component_source")
  @@map("sys_conf_pricing_components")
}

model SystemCrystal {
  idSystem  Int
  idCrystal Int
  sortOrder Int @default(0)

  system  System  @relation(fields: [idSystem], references: [id], onDelete: Cascade)
  crystal Crystal @relation(fields: [idCrystal], references: [id], onDelete: Restrict)

  @@id([idSystem, idCrystal])
  @@index([idCrystal])
  @@map("system_crystals")
}

model ActiveOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfActiveOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]             @relation("SysConfDefaultActiveOption")

  @@map("active_options")
}

model PreparationOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfPreparationOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]                  @relation("SysConfDefaultPreparationOption")

  @@map("preparation_options")
}

model SillOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfSillOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]           @relation("SysConfDefaultSillOption")

  @@map("sill_options")
}

model ReinforcementOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfReinforcementOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]                    @relation("SysConfDefaultReinforcementOption")
  dimensionPolicies  DimensionPolicy[]            @relation("ReinforcementDimensionPolicies")

  @@map("reinforcement_options")
}

model SysConfActiveOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf      @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  ActiveOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_active_options")
}

model SysConfPreparationOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf           @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  PreparationOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_preparation_options")
}

model SysConfSillOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf    @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  SillOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_sill_options")
}

model SysConfReinforcementOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf             @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  ReinforcementOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_reinforcement_options")
}

model FrameColor {
  id              Int     @id @default(autoincrement())
  color           String
  hexCode         String  @default("#FFFFFF") @db.VarChar(7)
  isActive        Boolean @default(true)
  isGlobal        Boolean @default(false)
  globalSortOrder Int     @default(0)

  pieces            Piece[]
  systemFrameColors SystemFrameColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isGlobal, isActive, globalSortOrder])
}

model SystemFrameColor {
  idSystem     Int
  idFrameColor Int
  sortOrder    Int @default(0)

  system     System     @relation(fields: [idSystem], references: [id], onDelete: Cascade)
  frameColor FrameColor @relation(fields: [idFrameColor], references: [id], onDelete: Restrict)

  @@id([idSystem, idFrameColor])
  @@index([idFrameColor])
  @@map("system_frame_colors")
}

model Crystal {
  id       Int     @id @default(autoincrement())
  glass    String
  isActive Boolean @default(true)

  pieces            Piece[]
  pricingRules      PricingRule[]
  pricingRangeRules PricingRangeRule[] @relation("CrystalPricingRangeRules")
  dimensionPolicies DimensionPolicy[]  @relation("CrystalDimensionPolicies")
  systemCrystals    SystemCrystal[]
  defaultForSystems System[]           @relation("SystemDefaultCrystal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Tint {
  id              Int         @id @default(autoincrement())
  color           String
  hexCode         String      @default("#F7FBFF") @db.VarChar(7)
  isActive        Boolean     @default(true)
  isGlobal        Boolean     @default(false)
  globalSortOrder Int         @default(0)
  pieces          Piece[]
  brandTints      BrandTint[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
  @@index([isGlobal, isActive, globalSortOrder])
}

model Coating {
  id              Int            @id @default(autoincrement())
  name            String
  isActive        Boolean        @default(true)
  isGlobal        Boolean        @default(false)
  globalSortOrder Int            @default(0)
  pieces          Piece[]
  brandCoatings   BrandCoating[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive])
  @@index([isGlobal, isActive, globalSortOrder])
}

model Privacy {
  id             Int            @id @default(autoincrement())
  name           String
  isActive       Boolean        @default(true)
  pieces         Piece[]
  brandPrivacies BrandPrivacy[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isActive])
}

model BrandTint {
  idBrand          Int
  idTint           Int
  sortOrder        Int      @default(0)
  surchargeEnabled Boolean  @default(false)
  isDefault        Boolean  @default(false)
  costoA           Decimal? @db.Decimal(24, 20)
  costoB           Decimal? @db.Decimal(24, 20)
  costoC           Decimal? @db.Decimal(24, 20)
  brand            Brand    @relation(fields: [idBrand], references: [id], onDelete: Cascade)
  tint             Tint     @relation(fields: [idTint], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([idBrand, idTint])
  @@index([idTint])
  @@index([idBrand, isDefault])
  @@index([idBrand, sortOrder])
  @@map("brand_tints")
}

model BrandCoating {
  idBrand          Int
  idCoating        Int
  sortOrder        Int      @default(0)
  surchargeEnabled Boolean  @default(false)
  isDefault        Boolean  @default(false)
  costoA           Decimal? @db.Decimal(24, 20)
  costoB           Decimal? @db.Decimal(24, 20)
  costoC           Decimal? @db.Decimal(24, 20)
  brand            Brand    @relation(fields: [idBrand], references: [id], onDelete: Cascade)
  coating          Coating  @relation(fields: [idCoating], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([idBrand, idCoating])
  @@index([idCoating])
  @@index([idBrand, isDefault])
  @@index([idBrand, sortOrder])
  @@map("brand_coatings")
}

model BrandPrivacy {
  idBrand          Int
  idPrivacy        Int
  sortOrder        Int      @default(0)
  surchargeEnabled Boolean  @default(false)
  isDefault        Boolean  @default(false)
  costoA           Decimal? @db.Decimal(24, 20)
  costoB           Decimal? @db.Decimal(24, 20)
  costoC           Decimal? @db.Decimal(24, 20)
  brand            Brand    @relation(fields: [idBrand], references: [id], onDelete: Cascade)
  privacy          Privacy  @relation(fields: [idPrivacy], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([idBrand, idPrivacy])
  @@index([idPrivacy])
  @@index([idBrand, isDefault])
  @@index([idBrand, sortOrder])
  @@map("brand_privacies")
}

model MuntinPattern {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  requiresLites Boolean  @default(true)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pieceMuntins PieceMuntin[]

  @@map("muntin_patterns")
}

model MuntinType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieceMuntins PieceMuntin[]

  @@map("muntin_types")
}

model PieceMuntin {
  id Int @id @default(autoincrement())

  piece   Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId Int   @unique

  pattern   MuntinPattern @relation(fields: [patternId], references: [id], onDelete: Restrict)
  patternId Int

  type   MuntinType? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeId Int?

  totalLites Int? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panels PieceMuntinPanel[]

  @@index([patternId])
  @@index([typeId])
  @@map("piece_muntins")
}

model PieceMuntinPanel {
  id Int @id @default(autoincrement())

  pieceMuntin   PieceMuntin @relation(fields: [pieceMuntinId], references: [id], onDelete: Cascade)
  pieceMuntinId Int

  panelIndex Int
  panelCode  String? @db.VarChar(20)
  panelLabel String  @db.VarChar(100)

  horizontalLites Int @default(1)
  verticalLites   Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pieceMuntinId, panelIndex], map: "uq_piece_muntin_panel_index")
  @@index([pieceMuntinId])
  @@map("piece_muntin_panels")
}

// ==================================================
//        Modelos para Parámetros de Cálculo
// ==================================================

enum GlobalParameterKey {
  SALES_TAX
  ESTIMATE_VALID_DAYS
  INSTALLATION_DEPOSIT
  INSTALLATION_PERMIT_FEE
  CARD_SURCHARGE_PERCENT
}

model GlobalParameter {
  id          Int                @id @default(autoincrement())
  key         GlobalParameterKey @unique
  value       Decimal            @db.Decimal(10, 4) // Usar Decimal para valores financieros
  description String?
  unit        String? // Útil para aclarar qué es el valor (ej. "%", "USD")
  updatedAt   DateTime           @updatedAt
}

model PricingRule {
  id        Int      @id @default(autoincrement())
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
