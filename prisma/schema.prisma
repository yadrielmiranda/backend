// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =======================================
//        Modelos de Autenticación y Usuarios
// =======================================

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  markup    Decimal  @default(0) @db.Decimal(10, 4) // Total 10 dígitos, 4 decimales
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  phone             String   @unique
  password          String
  passwordUpdatedAt DateTime @default(now())

  street     String @db.VarChar(150)
  city       String @db.VarChar(100)
  state      String @db.VarChar(50)
  postalCode String @db.VarChar(20)

  markupOverride Decimal? @db.Decimal(10, 4)
  isTaxExempt    Boolean  @default(false)

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  role   Role @relation(fields: [idRole], references: [id])
  idRole Int

  estimates           Estimate[]
  payments            Payment[]
  orders              Order[]
  notifications       Notification[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  branding            Branding?
  eventLogs           EventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([deletedAt])
}

model Session {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  refreshTokenHash String @db.VarChar(255)

  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  lastRefreshedAt DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(64)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum BrandingType {
  COMPANY
  DEALER
}

model Branding {
  id Int @id @default(autoincrement())

  type   BrandingType
  userId Int?         @unique // solo cuando type=DEALER  1 branding por dealer

  // Header info
  name    String  @db.VarChar(150)
  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(150)
  website String? @db.VarChar(150)

  street     String? @db.VarChar(150)
  city       String? @db.VarChar(100)
  state      String? @db.VarChar(50)
  postalCode String? @db.VarChar(20)

  logoUrl String? @db.VarChar(500)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación (dealer)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reglas para que no se dupliquen:

  @@index([type, isActive])
  @@map("branding")
}

// =======================================
//        Modelos de Piezas y Opciones
// =======================================

model Brand {
  id                 Int                 @id @default(autoincrement())
  name               String
  isActive           Boolean             @default(true)
  highBottomPercent  Decimal?            @db.Decimal(10, 4)
  pieces             Piece[]
  brandProducts      BrandProduct[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([isActive])
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  isActive Boolean @default(true)

  kind        ProductKind @default(GLAZED_UNIT)
  pricingMode PricingMode @default(AREA_PERIMETER)

  // comentario en español: selecciona la familia visual del diagrama
  diagramFamily DiagramFamily @default(GENERIC)

  configs            Config[]
  configCategories   ConfigCategory[]
  pieces             Piece[]
  brandProducts      BrandProduct[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([kind])
  @@index([diagramFamily])
}

enum ProductKind {
  GLAZED_UNIT
  LINEAR_MATERIAL
}

enum DiagramFamily {
  GENERIC
  BIFOLD
  CASEMENT
  FIXED_SHAPE
  FRENCH_DOOR
  GARAGE_DOOR
  HORIZONTAL_SLIDER
  LINEAR_MATERIAL
  PIVOT_DOOR
  SINGLE_HUNG
  SLIDING_DOOR
  WINDOW_WALL
}

model BrandProduct {
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  systems   System[]

  @@id([idBrand, idProduct])
  @@map("brand_product")
}

model System {
  id           Int          @id @default(autoincrement())
  name         String
  brandProduct BrandProduct @relation(fields: [idBrand, idProduct], references: [idBrand, idProduct])
  idBrand      Int
  idProduct    Int

  isActive Boolean @default(true)

  allowHighBottom Boolean @default(false)

  defaultCrystalId Int?
  defaultCrystal   Crystal? @relation("SystemDefaultCrystal", fields: [defaultCrystalId], references: [id], onDelete: SetNull)

  defaultConfigId Int?
  defaultConfig   Config? @relation("SystemDefaultConfig", fields: [defaultConfigId], references: [id], onDelete: SetNull)

  systemCrystals    SystemCrystal[]
  systemFrameColors SystemFrameColor[]

  sysconfs           SysConf[]
  pieces             Piece[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([defaultCrystalId])
  @@index([defaultConfigId])
  @@index([isActive])
}

model Config {
  id        Int     @id @default(autoincrement())
  conf      String
  prod      Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  isActive  Boolean @default(true)

  categoryId Int?
  category   ConfigCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sysconfs           SysConf[]
  defaultForSystems  System[]            @relation("SystemDefaultConfig")
  pieces             Piece[]
  pricingRules       PricingRule[]
  linearPricingRules LinearPricingRule[]

  requiresWidth        Boolean @default(false)
  requiresHeight       Boolean @default(false)
  requiresHeightLeft   Boolean @default(false)
  requiresHeightRight  Boolean @default(false)
  requiresLegHeight    Boolean @default(false)
  requiresSashHeight   Boolean @default(false)
  requiresWindowHeight Boolean @default(false)

  muntinLayout Json?

  // comentario en español: estructura visual base de la configuración
  // Puede referenciar valores dinámicos de Piece como rightPanels.
  diagramSpec Json?

  // comentario en español: permite migrar la estructura JSON en el futuro
  diagramSpecVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([idProduct, isActive])
  @@index([categoryId])
}

model ConfigCategory {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  product   Product @relation(fields: [idProduct], references: [id], onDelete: Cascade)
  idProduct Int

  configs Config[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idProduct, name])
  @@index([idProduct])
  @@index([isActive])
  @@map("config_categories")
}

enum PricingComponentType {
  DOOR
  SIDELITE
  TRANSOM
}

model SysConf {
  system                  System        @relation(fields: [idSystem], references: [id])
  idSystem                Int
  config                  Config        @relation(fields: [idConfig], references: [id])
  idConfig                Int
  allowScreen             Boolean       @default(false)
  isSelectableInEstimate  Boolean       @default(true)
  sortOrder               Int           @default(0)
  dimensionMode           DimensionMode @default(STANDARD)
  minimumBillableHeightIn Decimal?      @db.Decimal(10, 3)

  requiresWidth       Boolean @default(false)
  requiresHeight      Boolean @default(false)
  requiresHeightLeft  Boolean @default(false)
  requiresHeightRight Boolean @default(false)
  requiresLegHeight   Boolean @default(false)

  requiresDoorWidth          Boolean @default(false)
  requiresDoorHeight         Boolean @default(false)
  requiresLeftSideliteWidth  Boolean @default(false)
  requiresRightSideliteWidth Boolean @default(false)

  requiresLeftPanels  Boolean @default(false)
  requiresRightPanels Boolean @default(false)

  requiresPanelCount        Boolean @default(false)
  requiresHorizontalHeights Boolean @default(false)

  defaultActiveOptionId        Int?
  defaultPreparationOptionId   Int?
  defaultSillOptionId          Int?
  defaultReinforcementOptionId Int?

  defaultActiveOption        ActiveOption?        @relation("SysConfDefaultActiveOption", fields: [defaultActiveOptionId], references: [id], onDelete: SetNull)
  defaultPreparationOption   PreparationOption?   @relation("SysConfDefaultPreparationOption", fields: [defaultPreparationOptionId], references: [id], onDelete: SetNull)
  defaultSillOption          SillOption?          @relation("SysConfDefaultSillOption", fields: [defaultSillOptionId], references: [id], onDelete: SetNull)
  defaultReinforcementOption ReinforcementOption? @relation("SysConfDefaultReinforcementOption", fields: [defaultReinforcementOptionId], references: [id], onDelete: SetNull)

  dimensionPolicies   DimensionPolicy[]         @relation("SysConfDimensionPolicies")
  pricingComponents   SysConfPricingComponent[] @relation("SysConfPricingComponentParent")
  usedAsPricingSource SysConfPricingComponent[] @relation("SysConfPricingComponentSource")
  pricingRanges       PricingRange[]            @relation("SysConfPricingRanges")

  activeOptions        SysConfActiveOption[]
  preparationOptions   SysConfPreparationOption[]
  sillOptions          SysConfSillOption[]
  reinforcementOptions SysConfReinforcementOption[]

  @@id([idSystem, idConfig])
  @@index([defaultActiveOptionId])
  @@index([defaultPreparationOptionId])
  @@index([defaultSillOptionId])
  @@index([defaultReinforcementOptionId])
  @@map("sys_conf")
}

model SysConfPricingComponent {
  idSystem       Int
  idConfig       Int
  componentType  PricingComponentType
  sourceConfigId Int
  quantity       Int?

  parentSysConf SysConf @relation("SysConfPricingComponentParent", fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  sourceSysConf SysConf @relation("SysConfPricingComponentSource", fields: [idSystem, sourceConfigId], references: [idSystem, idConfig], onDelete: Restrict)

  @@id([idSystem, idConfig, componentType])
  @@index([idSystem, sourceConfigId], map: "idx_sys_conf_pricing_component_source")
  @@map("sys_conf_pricing_components")
}

model SystemCrystal {
  idSystem  Int
  idCrystal Int
  sortOrder Int @default(0)

  system  System  @relation(fields: [idSystem], references: [id], onDelete: Cascade)
  crystal Crystal @relation(fields: [idCrystal], references: [id], onDelete: Restrict)

  @@id([idSystem, idCrystal])
  @@index([idCrystal])
  @@map("system_crystals")
}

model ActiveOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfActiveOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]             @relation("SysConfDefaultActiveOption")

  @@map("active_options")
}

model PreparationOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfPreparationOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]                  @relation("SysConfDefaultPreparationOption")

  @@map("preparation_options")
}

model SillOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfSillOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]           @relation("SysConfDefaultSillOption")

  @@map("sill_options")
}

model ReinforcementOption {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConfOptions     SysConfReinforcementOption[]
  pieces             Piece[]
  defaultForSysConfs SysConf[]                    @relation("SysConfDefaultReinforcementOption")
  dimensionPolicies  DimensionPolicy[]            @relation("ReinforcementDimensionPolicies")

  @@map("reinforcement_options")
}

model SysConfActiveOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf      @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  ActiveOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_active_options")
}

model SysConfPreparationOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf           @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  PreparationOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_preparation_options")
}

model SysConfSillOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf    @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  SillOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_sill_options")
}

model SysConfReinforcementOption {
  idSystem  Int
  idConfig  Int
  optionId  Int
  sortOrder Int @default(0)

  sysConf SysConf             @relation(fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  option  ReinforcementOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([idSystem, idConfig, optionId])
  @@index([optionId])
  @@map("sysconf_reinforcement_options")
}

model FrameColor {
  id       Int     @id @default(autoincrement())
  color    String
  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  pieces            Piece[]
  systemFrameColors SystemFrameColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SystemFrameColor {
  idSystem     Int
  idFrameColor Int
  sortOrder    Int @default(0)

  system     System     @relation(fields: [idSystem], references: [id], onDelete: Cascade)
  frameColor FrameColor @relation(fields: [idFrameColor], references: [id], onDelete: Restrict)

  @@id([idSystem, idFrameColor])
  @@index([idFrameColor])
  @@map("system_frame_colors")
}

model Crystal {
  id       Int     @id @default(autoincrement())
  glass    String
  isActive Boolean @default(true)

  pieces            Piece[]
  pricingRules      PricingRule[]
  pricingRangeRules PricingRangeRule[] @relation("CrystalPricingRangeRules")
  dimensionPolicies DimensionPolicy[]  @relation("CrystalDimensionPolicies")
  systemCrystals    SystemCrystal[]
  defaultForSystems System[]           @relation("SystemDefaultCrystal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Tint {
  id        Int      @id @default(autoincrement())
  color     String
  isActive  Boolean  @default(true)
  pieces    Piece[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Coating {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  pieces    Piece[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model MuntinPattern {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  requiresLites Boolean  @default(true)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pieceMuntins PieceMuntin[]

  @@map("muntin_patterns")
}

model MuntinType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieceMuntins PieceMuntin[]

  @@map("muntin_types")
}

model PieceMuntin {
  id Int @id @default(autoincrement())

  piece   Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId Int   @unique

  pattern   MuntinPattern @relation(fields: [patternId], references: [id], onDelete: Restrict)
  patternId Int

  type   MuntinType? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeId Int?

  totalLites Int? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panels PieceMuntinPanel[]

  @@index([patternId])
  @@index([typeId])
  @@map("piece_muntins")
}

model PieceMuntinPanel {
  id Int @id @default(autoincrement())

  pieceMuntin   PieceMuntin @relation(fields: [pieceMuntinId], references: [id], onDelete: Cascade)
  pieceMuntinId Int

  panelIndex Int
  panelCode  String? @db.VarChar(20)
  panelLabel String  @db.VarChar(100)

  horizontalLites Int @default(1)
  verticalLites   Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pieceMuntinId, panelIndex], map: "uq_piece_muntin_panel_index")
  @@index([pieceMuntinId])
  @@map("piece_muntin_panels")
}

// ==================================================
//        Modelos para Parámetros de Cálculo
// ==================================================

enum GlobalParameterKey {
  SALES_TAX
  ESTIMATE_VALID_DAYS
}

model GlobalParameter {
  id          Int                @id @default(autoincrement())
  key         GlobalParameterKey @unique
  value       Decimal            @db.Decimal(10, 4) // Usar Decimal para valores financieros
  description String?
  unit        String? // Útil para aclarar qué es el valor (ej. "%", "USD")
  updatedAt   DateTime           @updatedAt
}

model PricingRule {
  id        Int      @id @default(autoincrement())
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  system    System   @relation(fields: [idSystem], references: [id])
  idSystem  Int
  config    Config   @relation(fields: [idConfig], references: [id])
  idConfig  Int
  crystal   Crystal  @relation(fields: [idCrystal], references: [id])
  idCrystal Int
  costoA    Decimal  @db.Decimal(24, 20) // Total 24 dígitos, 20 decimales
  costoB    Decimal  @db.Decimal(24, 20) // Total 24 dígitos, 20 decimales
  costoC    Decimal  @db.Decimal(24, 20) // Total 24 dígitos, 20 decimales
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idBrand, idProduct, idSystem, idConfig, idCrystal], map: "unique_pricing_rule_combination")
  @@map("pricing_rules")
}

model PricingRange {
  id Int @id @default(autoincrement())

  idSystem Int
  idConfig Int

  code String @db.VarChar(30)

  minWidthIn        Decimal? @db.Decimal(10, 3)
  minWidthInclusive Boolean  @default(true)
  maxWidthIn        Decimal? @db.Decimal(10, 3)
  maxWidthInclusive Boolean  @default(true)

  minHeightIn        Decimal? @db.Decimal(10, 3)
  minHeightInclusive Boolean  @default(true)
  maxHeightIn        Decimal? @db.Decimal(10, 3)
  maxHeightInclusive Boolean  @default(true)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sysConf SysConf            @relation("SysConfPricingRanges", fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)
  rules   PricingRangeRule[]

  @@unique([idSystem, idConfig, code], map: "uq_pricing_range_sysconf_code")
  @@index([idSystem, idConfig, isActive], map: "idx_pricing_range_sysconf_active")
  @@map("pricing_ranges")
}

model PricingRangeRule {
  id Int @id @default(autoincrement())

  rangeId   Int
  idCrystal Int

  costoA Decimal @db.Decimal(24, 20)
  costoB Decimal @db.Decimal(24, 20)
  costoC Decimal @db.Decimal(24, 20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  range   PricingRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  crystal Crystal      @relation("CrystalPricingRangeRules", fields: [idCrystal], references: [id], onDelete: Restrict)

  @@unique([rangeId, idCrystal], map: "uq_pricing_range_rule_range_crystal")
  @@index([idCrystal], map: "idx_pricing_range_rule_crystal")
  @@map("pricing_range_rules")
}

model LinearPricingRule {
  id Int @id @default(autoincrement())

  brand   Brand @relation(fields: [idBrand], references: [id])
  idBrand Int

  product   Product @relation(fields: [idProduct], references: [id])
  idProduct Int

  system   System @relation(fields: [idSystem], references: [id])
  idSystem Int

  config   Config @relation(fields: [idConfig], references: [id])
  idConfig Int

  costPerInch Decimal @db.Decimal(18, 8)

  minLengthIn Decimal @default(20) @db.Decimal(10, 3)
  maxLengthIn Decimal @default(288) @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idBrand, idProduct, idSystem, idConfig], map: "uq_linear_pricing_rule")
  @@index([idProduct])
  @@index([idSystem, idConfig])
  @@map("linear_pricing_rules")
}

enum PricingMode {
  AREA_PERIMETER
  LINEAR_INCH
}

// =======================================
//        Modelos de Cotizaciones y Pedidos
// =======================================

model EstimateStatus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  estimates Estimate[]
}

model EstimateSequence {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model Estimate {
  id        Int       @id @default(autoincrement())
  number    String    @unique
  name      String
  date      DateTime  @default(now())
  expiresAt DateTime?

  publicToken          String?   @unique @db.VarChar(64)
  publicTokenEnabled   Boolean   @default(true)
  publicTokenCreatedAt DateTime?

  // --- BASE ---
  units Int // suma de qty de todas las piezas

  // --- TÚ → DEALER O CLIENTE ---
  rateT     Decimal @db.Decimal(12, 2) // suma(rate * qty)
  priceT    Decimal @db.Decimal(12, 2) // suma(price * qty)
  netProfit Decimal @db.Decimal(12, 2) // priceT - rateT

  // --- TUS TAXES (factory → dealer/cliente) ---
  taxRate   Decimal @default(0) @db.Decimal(10, 4)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  // Lo que tú recibes
  totalPayable Decimal @default(0) @db.Decimal(12, 2) // priceT + taxAmount

  // --- DEALER → CUSTOMER ---
  customerPriceT       Decimal @default(0) @db.Decimal(12, 2) // suma(customerPrice * qty)
  customerTaxRate      Decimal @default(0) @db.Decimal(10, 4)
  customerTaxAmount    Decimal @default(0) @db.Decimal(12, 2)
  customerTotalPayable Decimal @default(0) @db.Decimal(12, 2)

  // --- GANANCIAS ---
  netProfitD Decimal @default(0) @db.Decimal(12, 2) // dealer profit

  // --- RELACIONES ---
  user     User           @relation(fields: [idUser], references: [id])
  idUser   Int
  status   EstimateStatus @relation(fields: [statusId], references: [id])
  statusId Int

  pieces  Piece[]
  order   Order?
  payment Payment?

  // --- CUSTOMER (dealer fills; not a relation) ---
  customerFirstName  String?  @db.VarChar(100)
  customerLastName   String?  @db.VarChar(100)
  customerEmail      String?  @db.VarChar(150)
  customerPhone      String?  @db.VarChar(30)
  customerStreet     String?  @db.VarChar(150)
  customerCity       String?  @db.VarChar(100)
  customerState      String?  @db.VarChar(50)
  customerPostalCode String?  @db.VarChar(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Piece {
  id      Int        @id @default(autoincrement())
  estim   Estimate   @relation(fields: [idEst], references: [id])
  idEst   Int
  mark    String
  prod    Product    @relation(fields: [idProd], references: [id])
  idProd  Int
  bran    Brand      @relation(fields: [idBrand], references: [id])
  idBrand Int
  syst    System     @relation(fields: [idSyst], references: [id])
  idSyst  Int
  conf    Config     @relation(fields: [idConf], references: [id])
  idConf  Int
  fColor  FrameColor @relation(fields: [idFC], references: [id])
  idFC    Int

  width        Decimal? @db.Decimal(10, 3)
  height       Decimal? @db.Decimal(10, 3)
  heightLeft   Decimal? @db.Decimal(10, 3)
  heightRight  Decimal? @db.Decimal(10, 3)
  legHeight    Decimal? @db.Decimal(10, 3)
  sashHeight   Decimal? @db.Decimal(10, 3)
  windowHeight Decimal? @db.Decimal(10, 3)

  doorWidth          Decimal? @db.Decimal(10, 3)
  doorHeight         Decimal? @db.Decimal(10, 3)
  leftSideliteWidth  Decimal? @db.Decimal(10, 3)
  rightSideliteWidth Decimal? @db.Decimal(10, 3)

  leftPanels  Int?
  rightPanels Int?

  panelCount        Int?
  horizontalHeights Json?

  cryst   Crystal? @relation(fields: [idCryst], references: [id])
  idCryst Int?

  tin    Tint? @relation(fields: [idTint], references: [id])
  idTint Int?

  privacy Boolean @default(false)

  coat   Coating? @relation(fields: [idCoat], references: [id])
  idCoat Int?

  dpPosPsf Decimal? @db.Decimal(10, 2)
  dpNegPsf Decimal? @db.Decimal(10, 2)
  screen   Boolean  @default(false)

  highBottom        Boolean  @default(false)
  highBottomPercent Decimal? @db.Decimal(10, 4)

  activeOption   ActiveOption? @relation(fields: [idActiveOption], references: [id])
  idActiveOption Int?

  preparationOption   PreparationOption? @relation(fields: [idPreparationOption], references: [id])
  idPreparationOption Int?

  sillOption   SillOption? @relation(fields: [idSillOption], references: [id])
  idSillOption Int?

  reinforcementOption   ReinforcementOption? @relation(fields: [idReinforcementOption], references: [id])
  idReinforcementOption Int?

  qty              Int
  rate             Decimal  @db.Decimal(12, 2)
  markup           Decimal  @default(0) @db.Decimal(10, 4)
  price            Decimal  @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  netProfit        Decimal  @db.Decimal(12, 2)
  dealerMarkup     Decimal  @default(0) @db.Decimal(10, 4)
  customerPrice    Decimal  @db.Decimal(12, 2)
  customerSubtotal Decimal  @db.Decimal(12, 2)
  netProfitD       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pieceMuntin PieceMuntin?

  @@index([idEst])
  @@index([idProd])
  @@index([idBrand])
  @@index([idSyst])
  @@index([idConf])
  @@index([idActiveOption])
  @@index([idPreparationOption])
  @@index([idSillOption])
  @@index([idReinforcementOption])
}

model OrderStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]
}

model Order {
  id     Int      @id @default(autoincrement())
  number String   @unique
  date   DateTime @default(now())

  units Int

  // amount = total con taxes incluidos (lo que paga el usuario)
  amount Decimal @db.Decimal(12, 2)

  // snapshot financiero (sin taxes) para cálculo de ganancia
  price     Decimal @db.Decimal(12, 2) // tu precio total (sin taxes)
  rate      Decimal @db.Decimal(12, 2) // tu costo estimado total (fábrica estimada)
  netProfit Decimal @db.Decimal(12, 2) // price - rate (ganancia estimada)

  // datos reales luego de meter la orden en la fábrica
  poNumber      String?  @unique @db.VarChar(50) // PO real de fábrica (único). Nullable hasta que lo tengas.
  rateReal      Decimal? @db.Decimal(12, 2) // costo real total que te cobra la fábrica
  netProfitReal Decimal? @db.Decimal(12, 2) // price - rateReal (ganancia real)

  estimate Estimate @relation(fields: [idEst], references: [id])
  idEst    Int      @unique

  status   OrderStatus @relation(fields: [statusId], references: [id])
  statusId Int

  updateStatus DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  // Pago asociado (Order solo debe existir si hubo pago)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId Int     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([statusId])
  @@index([date])
}

// =======================================
//   Modelo de Notificaciones
// =======================================
model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // La única relación necesaria es con el usuario que recibe la notificación
  recipient   User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int

  @@index([recipientId])
}

enum DimensionSizeBasis {
  FRAME
  DLO
}

enum DimensionRounding {
  ROUND_UP_TO_NEXT
  NEAREST
}

enum DimensionMode {
  STANDARD
  ECO_WINDOWS_DOOR
  ECO_NOVO_DOOR
  WINDOW_WALL
}

enum DimensionRuleType {
  MAIN
  DOOR
  SIDELITE
  TRANSOM
}

model DimensionPolicy {
  id Int @id @default(autoincrement())

  // 🔗 Referencia a SysConf (PK compuesta)
  idSystem Int
  idConfig Int
  sysConf  SysConf @relation("SysConfDimensionPolicies", fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)

  // 🔗 Referencia a Crystal
  idCrystal Int
  crystal   Crystal @relation("CrystalDimensionPolicies", fields: [idCrystal], references: [id], onDelete: Restrict)

  // 🔗 Referencia opcional a Reinforcement / Interlock
  idReinforcementOption Int?
  reinforcementOption   ReinforcementOption? @relation("ReinforcementDimensionPolicies", fields: [idReinforcementOption], references: [id], onDelete: Restrict)

  // Parámetros de interpretación de la tabla
  sizeBasis    DimensionSizeBasis @default(FRAME)
  roundingRule DimensionRounding  @default(ROUND_UP_TO_NEXT)
  notes        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules DimensionRule[]

  // Ahora sí: una policy por System + Config + Crystal + Reinforcement/Interlock.
  @@unique([idSystem, idConfig, idCrystal, idReinforcementOption], map: "uq_policy_sysconf_crystal_reinf")
  // Índice dedicado para sostener el FK hacia sys_conf.
  // Esto evita depender del unique viejo para idSystem/idConfig.
  @@index([idSystem, idConfig], map: "idx_dimension_policy_sysconf")
  // Índice para el FK opcional hacia reinforcement_options.
  @@index([idReinforcementOption], map: "idx_dimension_policy_reinforcement")
  @@map("dimension_policy")
}

model DimensionRule {
  id       Int @id @default(autoincrement())
  idPolicy Int

  ruleType DimensionRuleType @default(MAIN)

  widthIn  Decimal @db.Decimal(10, 3)
  heightIn Decimal @db.Decimal(10, 3)
  dpPosPsf Decimal @db.Decimal(10, 2)
  dpNegPsf Decimal @db.Decimal(10, 2)

  screws Int

  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy DimensionPolicy @relation(fields: [idPolicy], references: [id], onDelete: Cascade)

  @@unique([idPolicy, ruleType, widthIn, heightIn], map: "uq_rule_policy_type_dims")
  @@index([idPolicy, widthIn, heightIn], map: "idx_rule_policy_dims")
  @@index([idPolicy, ruleType], map: "idx_rule_policy_type")
  @@index([idPolicy, ruleType, widthIn, heightIn], map: "idx_rule_policy_type_dims")
}

// =======================================
//   Pagos (Stripe)
// =======================================

enum PaymentStatus {
  PENDING // creado checkout, esperando pago
  PAID // pago confirmado
  FAILED // pago falló
  CANCELED // usuario canceló
  EXPIRED // sesión expiró
  REFUNDED // reembolsado (opcional para futuro)
}

model Payment {
  id     Int           @id @default(autoincrement())
  status PaymentStatus @default(PENDING)

  // A qué Estimate corresponde este pago
  estimate Estimate @relation(fields: [idEst], references: [id], onDelete: Cascade)
  idEst    Int      @unique

  // Quién pagó (dealer o client; ambos son usuarios en tu sistema)
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int

  // Monto cobrado (normalmente estimate.totalPayable)
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("usd") @db.VarChar(10)

  // Stripe IDs (para reconciliar con webhooks)
  stripeSessionId       String? @unique @db.VarChar(255)
  stripePaymentIntentId String? @unique @db.VarChar(255)
  stripeCustomerId      String? @db.VarChar(255)

  // Relación 1:1 con Order (solo existe si el pago fue exitoso y se creó la orden)
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// =======================================
//   Logs (Event + Temp)
// =======================================

model EventLog {
  id Int @id @default(autoincrement())

  action     String
  entityType String
  entityId   Int

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  message   String?
  createdAt DateTime @default(now())

  // relación 1:1 opcional
  tempLog TempLog?

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("event_logs")
}

model TempLog {
  id Int @id @default(autoincrement())

  //  UNIQUE = solo un TempLog por EventLog
  eventId Int      @unique
  event   EventLog @relation(fields: [eventId], references: [id], onDelete: Cascade)

  before Json?
  after  Json?
  meta   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("temp_logs")
}
