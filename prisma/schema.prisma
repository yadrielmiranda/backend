// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique 
  users User[] // Relación inversa para ver todos los usuarios de un rol
}

model User {
  id        Int      @default(autoincrement()) @id
  username  String   @unique
  firstName String
  lastName  String
  email     String   @unique
  phone     String   @unique
  password  String
  address   String    
  role      Role     @relation(fields: [idRole], references: [id])
  idRole    Int
  estimates Estimate[]
}

model Brand {
  id            Int            @default(autoincrement()) @id
  name          String
  pieces        Piece[]
  brandProducts BrandProduct[]
}

model Product {
  id            Int            @default(autoincrement()) @id
  name          String
  configs       Config[]
  pieces        Piece[]
  brandProducts BrandProduct[]
}

model BrandProduct {
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  systems   System[]

  @@id([idBrand, idProduct])
  @@map("brand_product")
}

model System {
  id           Int          @id @default(autoincrement())
  name         String
  brandProduct BrandProduct @relation(fields: [idBrand, idProduct], references: [idBrand, idProduct])
  idBrand      Int
  idProduct    Int
  sysconfs     SysConf[]
  pieces       Piece[]
}

model Config {
  id        Int       @id @default(autoincrement())
  conf      String
  prod      Product   @relation(fields: [idProduct], references: [id])
  idProduct Int
  sysconfs  SysConf[]
  pieces    Piece[]
}

model SysConf {
  system   System @relation(fields: [idSystem], references: [id])
  idSystem Int
  config   Config @relation(fields: [idConfig], references: [id])
  idConfig Int

  @@id([idSystem, idConfig])
  @@map("sys_conf")
}

model FrameColor {
  id     Int     @default(autoincrement()) @id
  color  String
  pieces Piece[]
}

model Crystal {
  id     Int     @default(autoincrement()) @id
  glass  String
  pieces Piece[]
}

model Tint {
  id     Int     @default(autoincrement()) @id
  color  String
  pieces Piece[]
}

model Coating {
  id     Int     @default(autoincrement()) @id
  name   String
  pieces Piece[]
}

model Estimate {
  id        Int      @default(autoincrement()) @id
  number    String   @unique
  name      String
  project   String
  date      DateTime @default(now())
  units     Int
  rateT     Decimal
  priceT    Decimal
  netProfit Decimal
  user      User     @relation(fields: [idUser], references: [id])
  idUser    Int
  active    Boolean
  pieces    Piece[]
}

model Piece {
  id      Int        @default(autoincrement()) @id
  estim   Estimate   @relation(fields: [idEst], references: [id])
  idEst   Int
  mark    String
  prod    Product    @relation(fields: [idProd], references: [id])
  idProd  Int
  bran    Brand      @relation(fields: [idBrand], references: [id])
  idBrand Int
  syst    System     @relation(fields: [idSyst], references: [id])
  idSyst  Int
  conf    Config     @relation(fields: [idConf], references: [id])
  idConf  Int
  fColor  FrameColor @relation(fields: [idFC], references: [id])
  idFC    Int
  width   String
  height  String
  cryst   Crystal    @relation(fields: [idCryst], references: [id])
  idCryst Int
  tin     Tint       @relation(fields: [idTint], references: [id])
  idTint  Int
  privacy Boolean
  coat    Coating    @relation(fields: [idCoat], references: [id])
  idCoat  Int
  screen  Boolean
  muntin  Boolean
  qty     Int
  rate    Decimal
  price   Decimal
  markup  Int
  subtotal Decimal
  netProfit Decimal
}
