// =======================================
//        Modelos de Cotizaciones y Pedidos
// =======================================

model EstimateStatus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  estimates Estimate[]
}

model EstimateSequence {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model Estimate {
  id        Int       @id @default(autoincrement())
  number    String    @unique
  name      String
  date      DateTime  @default(now())
  expiresAt DateTime?

  publicToken          String?   @unique @db.VarChar(64)
  publicTotalToken     String?   @unique @db.VarChar(64)
  publicTokenEnabled   Boolean   @default(true)
  publicTokenCreatedAt DateTime?

  // --- BASE ---
  units Int // suma de qty de todas las piezas

  // Stable commercial classification used by payment/order creation.
  // Profit reporting itself remains exclusively on Order.
  dealerModeSnapshot        DealerMode?
  dealerAffiliationSnapshot DealerAffiliation?
  ownerMarkupSnapshot       Decimal            @default(0) @db.Decimal(24, 18)

  // --- TÚ → DEALER O CLIENTE ---
  rateT     Decimal @db.Decimal(12, 2) // suma(rate * qty)
  priceT    Decimal @db.Decimal(12, 2) // suma(price * qty)
  netProfit Decimal @db.Decimal(12, 2) // priceT - rateT

  // --- TUS TAXES (factory → dealer/cliente) ---
  taxRate   Decimal @default(0) @db.Decimal(10, 4)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  // Lo que tú recibes
  totalPayable Decimal @default(0) @db.Decimal(12, 2) // priceT + taxAmount

  // --- DEALER → CUSTOMER ---
  customerPriceT       Decimal @default(0) @db.Decimal(12, 2) // suma(customerPrice * qty)
  customerTaxRate      Decimal @default(0) @db.Decimal(10, 4)
  customerTaxAmount    Decimal @default(0) @db.Decimal(12, 2)
  customerTotalPayable Decimal @default(0) @db.Decimal(12, 2)

  // --- GANANCIAS ---
  netProfitD Decimal @default(0) @db.Decimal(12, 2) // dealer profit

  // --- RELACIONES ---
  user     User           @relation(fields: [idUser], references: [id])
  idUser   Int
  status   EstimateStatus @relation(fields: [statusId], references: [id])
  statusId Int

  pieces          Piece[]
  order           Order?
  payments        Payment[]
  installationJob InstallationJob?
  revisions       EstimateRevision[]

  // --- CUSTOMER (dealer fills; not a relation) ---
  customerFirstName  String?  @db.VarChar(100)
  customerLastName   String?  @db.VarChar(100)
  customerEmail      String?  @db.VarChar(150)
  customerPhone      String?  @db.VarChar(30)
  customerStreet     String?  @db.VarChar(150)
  customerCity       String?  @db.VarChar(100)
  customerState      String?  @db.VarChar(50)
  customerPostalCode String?  @db.VarChar(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Piece {
  id      Int        @id @default(autoincrement())
  estim   Estimate   @relation(fields: [idEst], references: [id])
  idEst   Int
  mark    String
  prod    Product    @relation(fields: [idProd], references: [id])
  idProd  Int
  bran    Brand      @relation(fields: [idBrand], references: [id])
  idBrand Int
  syst    System     @relation(fields: [idSyst], references: [id])
  idSyst  Int
  conf    Config     @relation(fields: [idConf], references: [id])
  idConf  Int
  fColor  FrameColor @relation(fields: [idFC], references: [id])
  idFC    Int

  width        Decimal? @db.Decimal(10, 3)
  height       Decimal? @db.Decimal(10, 3)
  heightLeft   Decimal? @db.Decimal(10, 3)
  heightRight  Decimal? @db.Decimal(10, 3)
  legHeight    Decimal? @db.Decimal(10, 3)
  sashHeight   Decimal? @db.Decimal(10, 3)
  windowHeight Decimal? @db.Decimal(10, 3)

  doorWidth          Decimal? @db.Decimal(10, 3)
  doorHeight         Decimal? @db.Decimal(10, 3)
  leftSideliteWidth  Decimal? @db.Decimal(10, 3)
  rightSideliteWidth Decimal? @db.Decimal(10, 3)

  leftPanels  Int?
  rightPanels Int?

  panelCount        Int?
  horizontalHeights Json?

  cryst   Crystal? @relation(fields: [idCryst], references: [id])
  idCryst Int?

  tin    Tint? @relation(fields: [idTint], references: [id])
  idTint Int?

  privacyOption Privacy? @relation(fields: [idPrivacy], references: [id], onDelete: Restrict)
  idPrivacy     Int?

  coat   Coating? @relation(fields: [idCoat], references: [id])
  idCoat Int?

  dpPosPsf Decimal? @db.Decimal(10, 2)
  dpNegPsf Decimal? @db.Decimal(10, 2)
  screen   Boolean  @default(false)

  highBottom        Boolean  @default(false)
  highBottomPercent Decimal? @db.Decimal(10, 4)

  activeOption   ActiveOption? @relation(fields: [idActiveOption], references: [id])
  idActiveOption Int?

  preparationOption   PreparationOption? @relation(fields: [idPreparationOption], references: [id])
  idPreparationOption Int?

  sillOption   SillOption? @relation(fields: [idSillOption], references: [id])
  idSillOption Int?

  reinforcementOption   ReinforcementOption? @relation(fields: [idReinforcementOption], references: [id])
  idReinforcementOption Int?

  qty              Int
  rate             Decimal  @db.Decimal(12, 2)
  markup           Decimal  @default(0) @db.Decimal(24, 18)
  price            Decimal  @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  netProfit        Decimal  @db.Decimal(12, 2)
  dealerMarkup     Decimal  @default(0) @db.Decimal(10, 4)
  customerPrice    Decimal  @db.Decimal(12, 2)
  customerSubtotal Decimal  @db.Decimal(12, 2)
  netProfitD       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pieceMuntin              PieceMuntin?
  installationMeasurements InstallationMeasurement[]

  @@index([idEst])
  @@index([idProd])
  @@index([idBrand])
  @@index([idSyst])
  @@index([idConf])
  @@index([idPrivacy])
  @@index([idActiveOption])
  @@index([idPreparationOption])
  @@index([idSillOption])
  @@index([idReinforcementOption])
}

model OrderStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]
}

model Order {
  id     Int      @id @default(autoincrement())
  number String   @unique
  date   DateTime @default(now())

  units Int

  // amount = total con taxes incluidos (lo que paga el usuario)
  amount Decimal @db.Decimal(12, 2)

  // Material-only financial snapshot (installation profit is intentionally excluded).
  // price/saleSubtotal are priceT for external sales and customerPriceT for internal sales.
  price        Decimal @db.Decimal(12, 2)
  saleSubtotal Decimal @default(0) @db.Decimal(12, 2)
  rate         Decimal @db.Decimal(12, 2) // estimated factory cost
  netProfit    Decimal @db.Decimal(12, 2) // total estimated material profit

  dealerModeSnapshot        DealerMode?
  dealerAffiliationSnapshot DealerAffiliation?
  impactMarkupRate          Decimal            @default(0) @db.Decimal(24, 18)
  factoryPriceWithMarkup    Decimal            @default(0) @db.Decimal(12, 2)
  impactProfit              Decimal            @default(0) @db.Decimal(12, 2)
  authenticProfit           Decimal            @default(0) @db.Decimal(12, 2)

  // datos reales luego de meter la orden en la fábrica
  poNumber                   String?  @unique @db.VarChar(50) // PO real de fábrica (único). Nullable hasta que lo tengas.
  rateReal                   Decimal? @db.Decimal(12, 2) // costo real total que te cobra la fábrica
  netProfitReal              Decimal? @db.Decimal(12, 2) // total real material profit
  factoryPriceWithMarkupReal Decimal? @db.Decimal(12, 2)
  impactProfitReal           Decimal? @db.Decimal(12, 2)
  authenticProfitReal        Decimal? @db.Decimal(12, 2)

  estimate Estimate @relation(fields: [idEst], references: [id])
  idEst    Int      @unique

  status   OrderStatus @relation(fields: [statusId], references: [id])
  statusId Int

  updateStatus DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  // Pago asociado (Order solo debe existir si hubo pago)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId Int     @unique

  extraCharges OrderExtraCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([statusId])
  @@index([date])
}

// =======================================
//   Modelo de Notificaciones
// =======================================
model Notification {
  id          Int      @id @default(autoincrement())
  message     String
  actionUrl   String?  @db.VarChar(500)
  actionLabel String?  @db.VarChar(80)
  dedupeKey   String?  @db.VarChar(191)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // La única relación necesaria es con el usuario que recibe la notificación
  recipient   User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int

  @@unique([recipientId, dedupeKey], map: "uq_notification_recipient_dedupe")
  @@index([recipientId])
}

enum DimensionSizeBasis {
  FRAME
  DLO
}

enum DimensionRounding {
  ROUND_UP_TO_NEXT
  NEAREST
}

enum DimensionMode {
  STANDARD
  ECO_WINDOWS_DOOR
  ECO_NOVO_DOOR
  WINDOW_WALL
}

enum DimensionRuleType {
  MAIN
  DOOR
  SIDELITE
}

model DimensionPolicy {
  id Int @id @default(autoincrement())

  // 🔗 Referencia a SysConf (PK compuesta)
  idSystem Int
  idConfig Int
  sysConf  SysConf @relation("SysConfDimensionPolicies", fields: [idSystem, idConfig], references: [idSystem, idConfig], onDelete: Cascade)

  // 🔗 Referencia a Crystal
  idCrystal Int
  crystal   Crystal @relation("CrystalDimensionPolicies", fields: [idCrystal], references: [id], onDelete: Restrict)

  // 🔗 Referencia opcional a Reinforcement / Interlock
  idReinforcementOption Int?
  reinforcementOption   ReinforcementOption? @relation("ReinforcementDimensionPolicies", fields: [idReinforcementOption], references: [id], onDelete: Restrict)

  // Parámetros de interpretación de la tabla
  sizeBasis    DimensionSizeBasis @default(FRAME)
  roundingRule DimensionRounding  @default(ROUND_UP_TO_NEXT)
  notes        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules DimensionRule[]

  // Ahora sí: una policy por System + Config + Crystal + Reinforcement/Interlock.
  @@unique([idSystem, idConfig, idCrystal, idReinforcementOption], map: "uq_policy_sysconf_crystal_reinf")
  // Índice dedicado para sostener el FK hacia sys_conf.
  // Esto evita depender del unique viejo para idSystem/idConfig.
  @@index([idSystem, idConfig], map: "idx_dimension_policy_sysconf")
  // Índice para el FK opcional hacia reinforcement_options.
  @@index([idReinforcementOption], map: "idx_dimension_policy_reinforcement")
  @@map("dimension_policy")
}

model DimensionRule {
  id       Int @id @default(autoincrement())
  idPolicy Int

  ruleType DimensionRuleType @default(MAIN)

  widthIn  Decimal @db.Decimal(10, 3)
  heightIn Decimal @db.Decimal(10, 3)
  dpPosPsf Decimal @db.Decimal(10, 2)
  dpNegPsf Decimal @db.Decimal(10, 2)

  screws Int

  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy DimensionPolicy @relation(fields: [idPolicy], references: [id], onDelete: Cascade)

  @@unique([idPolicy, ruleType, widthIn, heightIn], map: "uq_rule_policy_type_dims")
  @@index([idPolicy, widthIn, heightIn], map: "idx_rule_policy_dims")
  @@index([idPolicy, ruleType], map: "idx_rule_policy_type")
  @@index([idPolicy, ruleType, widthIn, heightIn], map: "idx_rule_policy_type_dims")
}

