  revision  EstimateRevision?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, version], map: "uq_installation_quote_job_version")
  @@index([jobId, status])
  @@index([profileId])
  @@index([createdById])
  @@map("installation_quotes")
}

model EstimateRevision {
  id                Int                     @id @default(autoincrement())
  estimateId        Int
  installationJobId Int
  quoteId           Int                     @unique
  version           Int
  status            EstimateRevisionStatus  @default(DRAFT)
  reason            InstallationQuoteReason @default(REMEASUREMENT)

  originalTotals Json
  revisedTotals  Json

  estimate        Estimate               @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  installationJob InstallationJob        @relation(fields: [installationJobId], references: [id], onDelete: Cascade)
  quote           InstallationQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("EstimateRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById     Int
  items           EstimateRevisionItem[]

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([installationJobId, version], map: "uq_estimate_revision_job_version")
  @@index([estimateId, status])
  @@index([createdById])
  @@map("estimate_revisions")
}

model EstimateRevisionItem {
  id              Int                          @id @default(autoincrement())
  revisionId      Int
  measurementId   Int
  originalPieceId Int?
  sourceUnitIndex Int
  action          EstimateRevisionItemAction
  reason          EstimateRevisionChangeReason @default(REMEASUREMENT)
  reasonNote      String?                      @db.VarChar(1000)

  originalSnapshot   Json
  proposedPieceInput Json?
  calculatedSnapshot Json?

  revision    EstimateRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  measurement InstallationMeasurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([revisionId, measurementId], map: "uq_estimate_revision_measurement")
  @@index([measurementId])
  @@index([originalPieceId, sourceUnitIndex])
  @@map("estimate_revision_items")
}

model InstallationQuoteLine {
  id            Int  @id @default(autoincrement())
  quoteId       Int
  serviceId     Int
  ruleId        Int?
  measurementId Int?

  origin InstallationLineOrigin

  sourceSystemId Int?
  sourceConfigId Int?
  componentIndex Int?
  componentLabel String? @db.VarChar(150)

  serviceNameSnapshot String                  @db.VarChar(150)
  billingUnitSnapshot InstallationBillingUnit
  ruleMetricSnapshot  InstallationRuleMetric
  ruleSnapshot        Json?

  widthIn     Decimal? @db.Decimal(10, 3)
  heightIn    Decimal? @db.Decimal(10, 3)
  areaSqFt    Decimal? @db.Decimal(12, 4)
  panelCount  Int?
  lengthIn    Decimal? @db.Decimal(10, 3)
  metricValue Decimal? @db.Decimal(12, 4)

  rate              Decimal @db.Decimal(12, 4)
  billableQuantity  Decimal @default(1) @db.Decimal(12, 4)
  occurrences       Int     @default(1)
  baseAmount        Decimal @db.Decimal(12, 2)
  adjustmentPercent Decimal @default(0) @db.Decimal(10, 4)
  adjustedAmount    Decimal @db.Decimal(12, 2)

  description String? @db.VarChar(500)
  sortOrder   Int     @default(0)

  quote       InstallationQuote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     InstallationService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  rule        InstallationServiceRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  measurement InstallationMeasurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId, sortOrder])
  @@index([serviceId])
  @@index([ruleId])
  @@index([measurementId])
  @@index([origin])
  @@map("installation_quote_lines")
}

model InstallationQuoteApproval {
  id       Int                          @id @default(autoincrement())
  quoteId  Int
  stage    InstallationApprovalStage
  decision InstallationApprovalDecision
  comment  String?                      @db.VarChar(1000)

  quote     InstallationQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor     User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId   Int
  createdAt DateTime          @default(now())

  @@index([quoteId, stage, createdAt])
  @@index([actorId])
  @@map("installation_quote_approvals")
}

model InstallationPermit {
  id     Int                      @id @default(autoincrement())
  jobId  Int                      @unique
  status InstallationPermitStatus @default(PAYMENT_PENDING)

  permitFeeSnapshot Decimal  @db.Decimal(12, 2)
  cityFee           Decimal? @db.Decimal(12, 2)
  notes             String?  @db.VarChar(1000)

  paidAt      DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?

  job InstallationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("installation_permits")
}

model InstallationAppointment {
  id           Int                           @id @default(autoincrement())
  jobId        Int
  type         InstallationAppointmentType   @default(INSTALLATION)
  status       InstallationAppointmentStatus @default(PROPOSED)
  startsAt     DateTime
  endsAt       DateTime?
  note         String?                       @db.VarChar(1000)
  responseNote String?                       @db.VarChar(1000)

  job           InstallationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposedBy    User            @relation("InstallationAppointmentProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  proposedById  Int
  respondedBy   User?           @relation("InstallationAppointmentRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById Int?
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, type, status, startsAt])
  @@index([proposedById])
  @@index([respondedById])
  @@map("installation_appointments")
}

// =======================================
//   Pagos (Stripe)
// =======================================

enum PaymentType {
  MATERIAL
  INSTALLATION_DEPOSIT
  PERMIT
  INSTALLATION
  EXTRA
}

enum OrderExtraChargeStatus {
  DRAFT
  PENDING_CUSTOMER_APPROVAL
  PAYMENT_DUE
  PAID
  REJECTED
  CANCELED
}

model OrderExtraCharge {
  id       Int                    @id @default(autoincrement())
  orderId  Int
  sequence Int
  status   OrderExtraChargeStatus @default(DRAFT)

  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  taxRateSnapshot Decimal @default(0) @db.Decimal(10, 4)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  total           Decimal @default(0) @db.Decimal(12, 2)
  notes           String? @db.VarChar(1000)
  decisionComment String? @db.VarChar(1000)

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy     User  @relation("OrderExtraChargeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById   Int
  respondedBy   User? @relation("OrderExtraChargeRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById Int?

  lines   OrderExtraChargeLine[]
  payment Payment?

  submittedAt DateTime?
  respondedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderId, sequence], map: "uq_order_extra_charge_sequence")
  @@index([orderId, status])
  @@index([createdById])
  @@index([respondedById])
  @@map("order_extra_charges")
}

model OrderExtraChargeLine {
  id            Int     @id @default(autoincrement())
  extraChargeId Int
  description   String  @db.VarChar(500)
  quantity      Decimal @default(1) @db.Decimal(12, 4)
  unitPrice     Decimal @db.Decimal(12, 2)
  taxable       Boolean @default(false)
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  sortOrder     Int     @default(0)

  extraCharge OrderExtraCharge @relation(fields: [extraChargeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([extraChargeId, sortOrder])
  @@map("order_extra_charge_lines")
}

enum PaymentStatus {
  PENDING // creado checkout, esperando pago
  PAID // pago confirmado
  FAILED // pago falló
  CANCELED // usuario canceló
  EXPIRED // sesión expiró
  REFUNDED // reembolsado (opcional para futuro)
}

enum PaymentMethod {
  CARD
  CHECK
  ZELLE
  CASH
  ACH
  WIRE
  OTHER
}

enum PaymentPayerType {
  ACCOUNT_OWNER
  CUSTOMER
}

model Payment {
  id       Int           @id @default(autoincrement())
  status   PaymentStatus @default(PENDING)
  type     PaymentType   @default(MATERIAL)
  // Deposit, Permit and material use sequence 1. Installation uses the
  // approved quote version so later approved field additions can create a new charge.
  sequence Int           @default(1)

  // A qué Estimate corresponde este pago
  estimate Estimate @relation(fields: [idEst], references: [id], onDelete: Cascade)
  idEst    Int

  installationJob   InstallationJob? @relation(fields: [installationJobId], references: [id], onDelete: SetNull)
  installationJobId Int?

  extraCharge   OrderExtraCharge? @relation(fields: [extraChargeId], references: [id], onDelete: SetNull)
  extraChargeId Int?              @unique

  // Account responsible for the estimate. For an internal dealer, the actual
  // payer is the final customer and is captured by payerType + snapshots.
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int

  payerType  PaymentPayerType @default(ACCOUNT_OWNER)
  payerName  String?          @db.VarChar(201)
  payerEmail String?          @db.VarChar(150)
  payerPhone String?          @db.VarChar(30)

  // Monto cobrado (normalmente estimate.totalPayable)
  baseAmount       Decimal @default(0) @db.Decimal(12, 2)
  surchargePercent Decimal @default(0) @db.Decimal(10, 4)
  surchargeAmount  Decimal @default(0) @db.Decimal(12, 2)
  amount           Decimal @db.Decimal(12, 2)
  currency         String  @default("usd") @db.VarChar(10)

  // Stripe IDs (para reconciliar con webhooks)
  stripeSessionId       String? @unique @db.VarChar(255)
  stripePaymentIntentId String? @unique @db.VarChar(255)
  stripeCustomerId      String? @db.VarChar(255)

  paymentMethod   PaymentMethod @default(CARD)
  paidAt          DateTime?
  manualReference String?       @db.VarChar(150)
  manualNote      String?       @db.VarChar(1000)
  recordedBy      User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById    Int?

  // Relación 1:1 con Order (solo existe si el pago fue exitoso y se creó la orden)
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idEst, type, sequence], map: "uq_payment_estimate_type_sequence")
  @@index([userId])
  @@index([status])
  @@index([installationJobId])
  @@index([recordedById])
  @@map("payments")
}

// =======================================
//   Logs (Event + Temp)
// =======================================

model EventLog {
  id Int @id @default(autoincrement())

  action     String
  entityType String
  entityId   Int

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  message   String?
  createdAt DateTime @default(now())

  // relación 1:1 opcional
  tempLog TempLog?

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("event_logs")
}

model TempLog {
  id Int @id @default(autoincrement())

  //  UNIQUE = solo un TempLog por EventLog
  eventId Int      @unique
  event   EventLog @relation(fields: [eventId], references: [id], onDelete: Cascade)

  before Json?
  after  Json?
  meta   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("temp_logs")
}
