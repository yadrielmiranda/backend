// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @default(autoincrement()) @id  
  username String @unique
  firstName  String  
  lastName  String
  email String @unique
  phone String @unique
  password String 
  address String
  admin Boolean
  estimates Estimate[]
}

model Product { 
  id Int @default(autoincrement()) @id    
  name  String 
  systems System[]
  configs Config[]
  pieces Piece[]
}

model System {
  id Int @default(autoincrement()) @id    
  name  String 
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  sysconfs SysConf[]
  pieces Piece[]
}

model Config {
  id Int @default(autoincrement()) @id
  conf String
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  sysconfs SysConf[]
  pieces Piece[]
}

model SysConf { 
  id Int @default(autoincrement()) @id   
  syst System @relation(fields: [idSys], references: [id]) 
  idSys Int
  config Config @relation(fields: [idConf], references: [id])
  idConf Int  
}

model FrameColor { 
  id Int @default(autoincrement()) @id    
  color String 
  pieces Piece[]
}

model Crystal { 
  id Int @default(autoincrement()) @id    
  glass String 
  pieces Piece[] 
}

model Tint { 
  id Int @default(autoincrement()) @id    
  color String
  pieces Piece[]  
}

model Coating { 
  id Int @default(autoincrement()) @id    
  name String  
  pieces Piece[]
}

model Estimate {
  id Int @default(autoincrement()) @id    
  code String 
  name String
  date DateTime @default(now())
  units Int
  total Decimal
  user User @relation(fields: [idUser], references: [id])
  idUser Int  
  active Boolean
  pieces Piece[]
}

model Piece {
  id Int @default(autoincrement()) @id    
  estim Estimate @relation(fields: [idEst], references: [id])
  idEst Int
  prod Product @relation(fields: [idProd], references: [id])
  idProd Int 
  syst System @relation(fields: [idSyst], references: [id])
  idSyst Int
  conf Config @relation(fields: [idConf], references: [id])
  idConf Int
  fColor FrameColor @relation(fields: [idFC], references: [id])
  idFC Int
  width String
  height String
  cryst Crystal @relation(fields: [idCryst], references: [id])
  idCryst Int
  tin Tint @relation(fields: [idTint], references: [id])
  idTint Int
  privacy Boolean
  coat Coating @relation(fields: [idCoat], references: [id])
  idCoat Int
  screen Boolean
  muntin Boolean
  price Decimal
}



  


