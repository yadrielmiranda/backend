// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @default(autoincrement()) @id  
  username String @unique
  firstName  String  
  lastName  String
  email String @unique
  phone String @unique
  password String 
  address String
  admin Boolean
}

model Product { 
  id Int @default(autoincrement()) @id    
  name  String 
  systems System[]
  configs Config[]
}

model System {
  id Int @default(autoincrement()) @id    
  name  String 
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
}

model Config {
  id Int @default(autoincrement()) @id
  conf String
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
}

model FrameColor { 
  id Int @default(autoincrement()) @id    
  color  String  
}

model Crystal { 
  id Int @default(autoincrement()) @id    
  glass  String  
}

model Tint { 
  id Int @default(autoincrement()) @id    
  color  String  
}

model Coating { 
  id Int @default(autoincrement()) @id    
  name  String  
}



