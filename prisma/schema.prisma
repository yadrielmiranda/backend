// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =======================================
//        Modelos de Autenticación y Usuarios
// =======================================

model Role {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  markup Decimal @default(0) @db.Decimal(10, 4) // Total 10 dígitos, 4 decimales
  users  User[]
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  firstName      String
  lastName       String
  email          String     @unique
  phone          String     @unique
  password       String
  address        String
  markupOverride Decimal?   @db.Decimal(10, 4) // Total 10 dígitos, 4 decimales
  role           Role       @relation(fields: [idRole], references: [id])
  idRole         Int
  estimates      Estimate[]
  orders         Order[]
}

// =======================================
//        Modelos de Piezas y Opciones
// =======================================

model Brand {
  id            Int            @id @default(autoincrement())
  name          String
  pieces        Piece[]
  brandProducts BrandProduct[]
  pricingRules  PricingRule[]
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  configs       Config[]
  pieces        Piece[]
  brandProducts BrandProduct[]
  pricingRules  PricingRule[]
}

model BrandProduct {
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  systems   System[]

  @@id([idBrand, idProduct])
  @@map("brand_product")
}

model System {
  id           Int          @id @default(autoincrement())
  name         String
  brandProduct BrandProduct @relation(fields: [idBrand, idProduct], references: [idBrand, idProduct])
  idBrand      Int
  idProduct    Int
  sysconfs     SysConf[]
  pieces       Piece[]
  pricingRules PricingRule[]
}

model Config {
  id           Int           @id @default(autoincrement())
  conf         String
  prod         Product       @relation(fields: [idProduct], references: [id])
  idProduct    Int
  sysconfs     SysConf[]
  pieces       Piece[]
  pricingRules PricingRule[]
}

model SysConf {
  system   System @relation(fields: [idSystem], references: [id])
  idSystem Int
  config   Config @relation(fields: [idConfig], references: [id])
  idConfig Int

  @@id([idSystem, idConfig])
  @@map("sys_conf")
}

model FrameColor {
  id     Int     @id @default(autoincrement())
  color  String
  pieces Piece[]
}

model Crystal {
  id           Int           @id @default(autoincrement())
  glass        String
  pieces       Piece[]
  pricingRules PricingRule[]
}

model Tint {
  id     Int     @id @default(autoincrement())
  color  String
  pieces Piece[]
}

model Coating {
  id     Int     @id @default(autoincrement())
  name   String
  pieces Piece[]
}

// ==================================================
//        Modelos para Parámetros de Cálculo
// ==================================================

enum ParameterKey {
  SALES_TAX
}

model CalculationParameter {
  id          Int          @id @default(autoincrement())
  key         ParameterKey @unique
  value       String
  description String?
  unit        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PricingRule {
  id        Int      @id @default(autoincrement())
  brand     Brand    @relation(fields: [idBrand], references: [id])
  idBrand   Int
  product   Product  @relation(fields: [idProduct], references: [id])
  idProduct Int
  system    System   @relation(fields: [idSystem], references: [id])
  idSystem  Int
  config    Config   @relation(fields: [idConfig], references: [id])
  idConfig  Int
  crystal   Crystal  @relation(fields: [idCrystal], references: [id])
  idCrystal Int
  costoA    Decimal  @db.Decimal(18, 8) // Total 18 dígitos, 8 decimales
  costoB    Decimal  @db.Decimal(18, 8) // Total 18 dígitos, 8 decimales
  costoC    Decimal  @db.Decimal(18, 8) // Total 18 dígitos, 8 decimales
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idBrand, idProduct, idSystem, idConfig, idCrystal], map: "unique_pricing_rule_combination")
  @@map("pricing_rules")
}

// =======================================
//        Modelos de Cotizaciones y Pedidos
// =======================================

model Estimate {
  id         Int      @id @default(autoincrement())
  number     String   @unique
  name       String
  date       DateTime @default(now())
  units      Int
  rateT      Decimal  @db.Decimal(12, 4)
  priceT     Decimal  @db.Decimal(12, 2)
  netProfit  Decimal  @db.Decimal(12, 4)
  total      Decimal  @db.Decimal(12, 2)
  netProfitD Decimal  @db.Decimal(12, 2)
  user       User     @relation(fields: [idUser], references: [id])
  idUser     Int
  active     Boolean
  pieces     Piece[]
  order      Order?
}

model Piece {
  id         Int        @id @default(autoincrement())
  estim      Estimate   @relation(fields: [idEst], references: [id])
  idEst      Int
  mark       String
  prod       Product    @relation(fields: [idProd], references: [id])
  idProd     Int
  bran       Brand      @relation(fields: [idBrand], references: [id])
  idBrand    Int
  syst       System     @relation(fields: [idSyst], references: [id])
  idSyst     Int
  conf       Config     @relation(fields: [idConf], references: [id])
  idConf     Int
  fColor     FrameColor @relation(fields: [idFC], references: [id])
  idFC       Int
  width      String
  height     String
  cryst      Crystal    @relation(fields: [idCryst], references: [id])
  idCryst    Int
  tin        Tint       @relation(fields: [idTint], references: [id])
  idTint     Int
  privacy    Boolean
  coat       Coating    @relation(fields: [idCoat], references: [id])
  idCoat     Int
  screen     Boolean
  muntin     Boolean
  qty        Int
  rate       Decimal    @db.Decimal(12, 4)
  price      Decimal    @db.Decimal(12, 2)
  markup     Int
  subtotal   Decimal    @db.Decimal(12, 2)
  netProfit  Decimal    @db.Decimal(12, 4)
  markupD    Decimal    @db.Decimal(12, 2)
  netProfitD Decimal    @db.Decimal(12, 2)
}

model OrderStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]
}

model Order {
  id       Int         @id @default(autoincrement())
  number   String      @unique
  date     DateTime    @default(now())
  units    Int
  amount   Decimal     @db.Decimal(12, 2)
  estimate Estimate    @relation(fields: [idEst], references: [id])
  idEst    Int         @unique
  status   OrderStatus @relation(fields: [statusId], references: [id])
  statusId Int
  user     User        @relation(fields: [userId], references: [id])
  userId   Int
}
