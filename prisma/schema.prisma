// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @default(autoincrement()) @id  
  username String @unique
  firstName  String  
  lastName  String
  email String @unique
  phone String @unique
  password String 
  address String
  admin Boolean
  estimates Estimate[]
}

model Product { 
  id Int @default(autoincrement()) @id    
  name  String 
  systems System[]
  configs Config[]
}

model System {
  id Int @default(autoincrement()) @id    
  name  String 
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  sysconfs SysConf[]
}

model Config {
  id Int @default(autoincrement()) @id
  conf String
  prod Product @relation(fields: [idProduct], references: [id])
  idProduct Int
  sysconfs SysConf[]
}

model SysConf { 
  id Int @default(autoincrement()) @id   
  syst System @relation(fields: [idSys], references: [id]) 
  idSys Int
  config Config @relation(fields: [idConf], references: [id])
  idConf Int  
}

model FrameColor { 
  id Int @default(autoincrement()) @id    
  color String  
}

model Crystal { 
  id Int @default(autoincrement()) @id    
  glass String  
}

model Tint { 
  id Int @default(autoincrement()) @id    
  color String  
}

model Coating { 
  id Int @default(autoincrement()) @id    
  name String  
}

model Estimate {
  id Int @default(autoincrement()) @id    
  code String 
  name String
  date DateTime @default(now())
  units Int
  total Decimal
  user User @relation(fields: [idUser], references: [id])
  idUser Int  
  active Boolean
}



  


