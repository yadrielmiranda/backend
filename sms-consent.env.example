# La autorización en Profile funciona sin configurar Twilio.
# Guardarlos en el .env privado del backend; nunca en NEXT_PUBLIC_*.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INBOUND_WEBHOOK_URL=https://api.authenticevolutionco.com/api/sms/twilio/incoming

# Envío de notificaciones de servicio a clients y dealers externos con consentimiento activo.
# API Key Restricted con el permiso twilio/messaging/messages/create.
# El Auth Token anterior se conserva para validar STOP/START.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Ya se usa en los correos del backend. Conservar su valor si está configurado.
PUBLIC_FRONTEND_URL=https://authenticevolutionco.com

# Aplicar la migración NotificationSms y generar Prisma antes de compilar/desplegar.
# Sin estas credenciales o una PUBLIC_FRONTEND_URL HTTPS válida, no se encolan SMS.
# Solo se envían notificaciones nuevas; no se envía el historial de la campana.
# ACCEPTED indica aceptación por Twilio. La entrega final se consulta en sus Message Logs.
# HTTP 429: hasta 3 intentos. FAILED/UNKNOWN: revisar en Twilio; no reenvío automático.
# PENDING caduca tras 24 horas. UNKNOWN evita duplicados tras un timeout o reinicio.

# Alternativa si el callback se configura a nivel de número.
# Advanced Opt-Out debe estar habilitado en su Messaging Service.
TWILIO_FROM_NUMBER=
