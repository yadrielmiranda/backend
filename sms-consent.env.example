# La autorización en Profile funciona sin configurar Twilio.
# Estos valores solo son necesarios al conectar las respuestas STOP/START.
# Guardarlos en el .env privado del backend; nunca en NEXT_PUBLIC_*.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INBOUND_WEBHOOK_URL=https://api.authenticevolutionco.com/api/sms/twilio/incoming

# Alternativa si el callback se configura a nivel de número.
# Advanced Opt-Out debe estar habilitado en su Messaging Service.
TWILIO_FROM_NUMBER=
